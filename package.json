{
	"name": "myhistory",
	"version": "0.1.3",
	"description": "An Obsidian plugin that keeps a local, private version history for your notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:typecheck": "tsc -p tsconfig.test.json -noEmit -skipLibCheck",
		"check": "npm run build && npm run test:typecheck && npm test",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"history",
		"versions"
	],
	"author": "H. Manduca",
	"license": "MIT",
	"engines": {
		"node": ">=22.22.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "0.25.5",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"obsidian": "^1.13.1",
		"pouchdb": "^9.0.0"
	},
	"overrides": {
		"uuid": "11.1.1"
	}
}
